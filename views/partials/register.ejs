<%- include('partials/header', { title: 'Регистрация — Instagram' }) %>

<div class="auth-page">
    <div class="auth-box">

        <div class="auth-box__logo">Instagram</div>

        <h2>
            Зарегистрируйтесь, чтобы видеть фото и видео ваших друзей
        </h2>

        <div id="alert-container"></div>

        <!-- Name -->
        <div class="form-group">
            <input
                    type="text"
                    id="name"
                    placeholder="Полное имя"
                    autocomplete="name"
            />
            <div class="field-error" id="name-error"></div>
        </div>

        <!-- Username -->
        <div class="form-group">
            <input
                    type="text"
                    id="username"
                    placeholder="Имя пользователя"
                    autocomplete="username"
            />
            <div class="field-error" id="username-error"></div>
        </div>

        <!-- Email -->
        <div class="form-group">
            <input
                    type="email"
                    id="email"
                    placeholder="Электронная почта"
                    autocomplete="email"
            />
            <div class="field-error" id="email-error"></div>
        </div>

        <!-- Password -->
        <div class="form-group">
            <input
                    type="password"
                    id="password"
                    placeholder="Пароль"
                    autocomplete="new-password"
            />
            <div class="field-error" id="password-error"></div>
        </div>

        <!-- Submit -->
        <button
                class="btn btn-primary"
                id="reg-btn"
                onclick="handleRegister()"
        >
            Зарегистрироваться
        </button>

        <div class="auth-switch">
            Уже есть аккаунт?
            <a href="/login">Войти</a>
        </div>

    </div>
</div>

<script>

    const btn = document.getElementById("reg-btn");
    const alertBox = document.getElementById("alert-container");

    const fields = ["name", "username", "email", "password"];

    if (localStorage.getItem("token")) {
        window.location.href = "/";
    }

    /* =========================
            REGISTER
    ========================= */

    async function handleRegister() {

        const name = getValue("name");
        const username = getValue("username");
        const email = getValue("email");
        const password = getValue("password");

        clearErrors();
        alertBox.innerHTML = "";

        if (!name || !username || !email || !password) {
            showAlert("Заполните все поля", "error");
            return;
        }

        setLoading(true);

        try {

            const res = await fetch("/users/register", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    name,
                    username,
                    email,
                    password
                })
            });

            const data = await res.json();

            if (!res.ok) {
                handleErrors(data);
                return;
            }

            showAlert(
                `✅ ${data.message || "Регистрация успешна!"}<br>
       Проверьте вашу почту для активации аккаунта.`,
                "success"
            );

            clearFields();

        } catch (err) {
            showAlert("Ошибка сети. Попробуйте снова.", "error");
        } finally {
            setLoading(false);
        }
    }

    /* =========================
            HELPERS
    ========================= */

    function getValue(id) {
        return document.getElementById(id).value.trim();
    }

    function handleErrors(data) {

        const errors = data.errors || {};

        fields.forEach(f => {
            const el = document.getElementById(f + "-error");
            if (el) el.textContent = "";
        });

        let hasFieldErrors = false;

        Object.keys(errors).forEach(key => {
            const el = document.getElementById(key + "-error");
            if (el) {
                el.textContent = errors[key];
                hasFieldErrors = true;
            }
        });

        if (!hasFieldErrors) {
            showAlert(data.message || "Ошибка регистрации", "error");
        }

    }

    function clearErrors() {
        fields.forEach(f => {
            const el = document.getElementById(f + "-error");
            if (el) el.textContent = "";
        });
    }

    function clearFields() {
        fields.forEach(f => {
            const el = document.getElementById(f);
            if (el) el.value = "";
        });
    }

    function setLoading(state) {
        btn.disabled = state;
        btn.textContent = state
            ? "Регистрируем..."
            : "Зарегистрироваться";
    }

    function showAlert(message, type = "error") {
        alertBox.innerHTML = `
    <div class="alert alert-${type}">
      ${message}
    </div>
  `;
    }

    /* Enter key support */
    document.addEventListener("keydown", (e) => {
        if (e.key === "Enter") handleRegister();
    });

</script>

<%- include('partials/footer') %>